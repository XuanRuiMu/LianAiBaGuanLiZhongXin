# 免费 TTS 配置（Edge-TTS，无需Key）
TTS_PROVIDER=auto
EDGE_TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_TIMEOUT=15
EDGE_TTS_MAX_RETRIES=2
TTS_CACHE_SIZE=200
TTS_MAX_CHARS=5000

# 服务配置
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# 同源键（与和我恋爱吧同名；值以和我恋爱吧/.env 为准，本文件留空，运行时由启动脚本从进程环境补齐）
JWT_SECRET=
INTERNAL_TOKEN=
REDIS_URL=
TTS_RATE_LIMIT=60
TTS_RATE_WINDOW_SECONDS=60
