# ============================================================
# 恋爱吧数据中心后端 环境变量说明（复制为 .env 后按实际值填写）
# 所有敏感值禁止硬编码进代码或 application.yml，一律通过环境变量覆盖。
# ============================================================

# ---- 管理员账号（POST /api/v1/auth/login 校验用）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- JWT 签名密钥（HS256，至少 32 字节，生产必须更换）----
JWT_SECRET=please-change-this-to-a-random-32bytes-min-secret!
JWT_TTL_HOURS=24

# ---- 内部接口令牌（Python AI 服务调用 /api/internal/** 时携带 X-Internal-Token）----
INTERNAL_TOKEN=change-me-internal-token

# ---- 目标分析库 MySQL（本服务自有库，读写）----
MYSQL_URL=jdbc:mysql://localhost:3307/love_analytics?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&rewriteBatchedStatements=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ---- 源业务库 PostgreSQL（只读，禁止写）----
SOURCE_PG_URL=jdbc:postgresql://localhost:55432/love_source
SOURCE_PG_USERNAME=readonly
SOURCE_PG_PASSWORD=

# ---- Redis（缓存三防）----
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=love-analytics-group
KAFKA_TOPIC_SYNC=love.sync.events
KAFKA_TOPIC_DLT=love.sync.events.DLT

# ---- 同步任务 ----
SYNC_FIXED_DELAY=PT5M
