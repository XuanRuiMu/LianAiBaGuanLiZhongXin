<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="日志格式" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %level [%thread] %logger{36} 追踪号=%X{traceId:-} %msg%n"/>
    <property name="日志目录" value="${LOG_DIR:-logs}"/>

    <appender name="控制台" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${日志格式}</pattern>
        </encoder>
    </appender>

    <appender name="文件" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${日志目录}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${日志目录}/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${日志格式}</pattern>
        </encoder>
    </appender>

    <logger name="com.lianai" level="INFO"/>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.springframework.kafka" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="控制台"/>
        <appender-ref ref="文件"/>
    </root>
</configuration>
