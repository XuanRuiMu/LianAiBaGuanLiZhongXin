# 恋爱吧管理中心 - 生产环境（MUST-CHANGE 项上线前必须替换）
# 环境同源：管理中心与和我恋爱吧共用同一 PostgreSQL/Redis/Network，不自建双栈双库。
# 主配置源为和我恋爱吧/.env（本地 sibling，仅运行时读取，密钥值从不入库）。
# 本文件仅覆写管理中心自身端口与管理侧 n8n 凭据；以下同名键留空，运行时由启动/部署脚本从主配置源按 fill-empty 语义补齐。
APP_ENV=prod

# ---- 同源键（与和我恋爱吧同名；值以和我恋爱吧/.env 为准，本文件留空） ----
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
JWT_EXPIRES_IN=15m
GUAN_LI_SHUA_XIN_YOU_XIAO_MIAO=604800
ADMIN_PHONES=
ALLOWED_ORIGINS=
NEI_WANG_BAI_MING_DAN=
TRUST_PROXY=loopback
FORCE_HTTPS=1
VITE_API_PROXY_TARGET=
INTERNAL_TOKEN=
TTS_SERVICE_URL=http://localhost:8001

# ---- 管理中心自身端口 ----
TTS_PORT=8001
N8N_PORT=5678
FRONT_PORT=5175
MANAGEMENT_BACKEND_PORT=3100

# ---- n8n 管理侧凭据（生产占位，上线前必须替换） ----
N8N_OWNER_EMAIL=admin@example.invalid
N8N_OWNER_FIRST_NAME=Management
N8N_OWNER_LAST_NAME=Owner
N8N_OWNER_PASSWORD_HASH='PROD-BCRYPT-HASH-MUST-CHANGE'
N8N_ENCRYPTION_KEY=PROD-N8N-KEY-MUST-CHANGE-32B
