# 恋爱吧数据中心 - 开发环境（以下均为演示级占位密码，仅限本地联调，禁止用于生产）
APP_ENV=dev

# ---- 中间件 ----
MYSQL_ROOT_PASSWORD=LoveDemo2026
MYSQL_DATABASE=love_analytics
MYSQL_PORT=3307
REDIS_PASSWORD=RedisDemo2026
REDIS_PORT=6380
KAFKA_PORT=9092
SOURCE_POSTGRES_DB=love_source
SOURCE_POSTGRES_PASSWORD=PgDemo2026
SOURCE_PG_PORT=55432
SOURCE_PG_USERNAME=readonly
SOURCE_PG_PASSWORD=ReadonlyDemo2026

# ---- 业务服务端口 ----
BACKEND_PORT=8080
AI_PORT=8000
TTS_PORT=8001
FRONT_PORT=5174

# ---- 共享凭证（开发环境占位值）----
INTERNAL_TOKEN=dev-internal-token-change-me
JWT_SECRET=dev-only-jwt-secret-change-me-min-32-bytes!!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_TTL_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]

# ---- 前端构建地址 ----
VITE_API_BASE=http://localhost:8080
VITE_AI_BASE=http://localhost:8000

# ---- AI 服务 ----
JAVA_BASE_URL=http://backend-java:8080
HTTP_TIMEOUT_SECONDS=5.0
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=60.0
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
HF_ENDPOINT=https://hf-mirror.com
CHROMA_COLLECTION=knowledge
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_TOP_K=4
MAX_ITERATIONS=6
MAX_HISTORY_MESSAGES=20
TOOL_EVENT_SUMMARY_LENGTH=300
CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW_SECONDS=60
MCP_ENABLED=true

# ---- TTS 服务 ----
TTS_PROVIDER=auto
EDGE_TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_TIMEOUT=15
EDGE_TTS_MAX_RETRIES=2
TTS_CACHE_SIZE=200
TTS_MAX_CHARS=5000
LOG_LEVEL=info
TTS_RATE_LIMIT=60
TTS_RATE_WINDOW_SECONDS=60

# ---- 后端同步 ----
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_GROUP_ID=love-analytics-group
KAFKA_TOPIC_SYNC=love.sync.events
KAFKA_TOPIC_DLT=love.sync.events.DLT
SYNC_ENABLED=true
SYNC_FIXED_DELAY=PT5M
SYNC_INITIAL_DELAY=PT15S
SYNC_TREND_DAYS=90
SYNC_RETRY_COUNT=2
SYNC_RETRY_BACKOFF_MILLIS=2000
CACHE_BASE_TTL_SECONDS=1800
CACHE_JITTER_TTL_SECONDS=300
CACHE_EMPTY_TTL_SECONDS=60
CACHE_LOCK_TTL_SECONDS=30
CACHE_WAIT_MILLIS=80
