# 恋爱吧管理中心 - 环境变量模板（复制 envs/.env.dev|test|prod 为 .env 后使用；同源键留空由主配置源补齐）
# 主配置源：和我恋爱吧/.env；管理中心仅覆写自身端口与管理侧凭据。
APP_ENV=dev

# ---- 同源键（与和我恋爱吧同名；值以和我恋爱吧/.env 为准，本文件留空） ----
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_PHONES=
ALLOWED_ORIGINS=
INTERNAL_TOKEN=
TTS_SERVICE_URL=http://localhost:8001

# ---- 管理中心自身端口 ----
TTS_PORT=8001
N8N_PORT=5678
FRONT_PORT=5175
# 管理后端端口（FP-04落实：避冲突选用3100；禁3000/3001/5173/5174/8001/5678/5432/6379）
MANAGEMENT_BACKEND_PORT=3100

# ---- n8n 管理侧凭据（MUST-CHANGE，上线前必须替换） ----
N8N_OWNER_EMAIL=admin@example.invalid
N8N_OWNER_FIRST_NAME=Management
N8N_OWNER_LAST_NAME=Owner
N8N_OWNER_PASSWORD_HASH='MUST-GENERATE-WITH-BCRYPT'
N8N_ENCRYPTION_KEY=MUST-CHANGE-32BYTES!!
